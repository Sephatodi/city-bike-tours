
# The Vite site's origin(s), comma separated. Dev: http://localhost:5173
FRONTEND_ORIGIN=
# Neon connection string (recommended for production)
NEON_DATABASE_URL=
# Optional local database connection string; used when NEON_DATABASE_URL is not set
DATABASE_URL=

# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Neon Auth (Google sign-in). Neon Console > your project > branch > Auth > Enable Auth, then copy the Auth URL.
# NEON_AUTH_COOKIE_SECRET: generate with  openssl rand -base64 32  (32+ characters).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Optional — OAuth providers only register if their vars are present.
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Apple (optional): APPLE_CLIENT_SECRET is the signed JWT described in lib/auth.js
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Admin account created by `npm run admin:provision`
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Booking confirmation email via Yahoo SMTP.
BOOKING_CONFIRMATION_EMAIL=aobakweramoleko3@yahoo.com
BOOKING_CONFIRMATION_SMTP_HOST=smtp.mail.yahoo.com
BOOKING_CONFIRMATION_SMTP_PORT=465
BOOKING_CONFIRMATION_SMTP_SECURE=true
BOOKING_CONFIRMATION_SMTP_USER=aobakweramoleko3@yahoo.com
BOOKING_CONFIRMATION_SMTP_PASS=

# WhatsApp click-to-chat (wa.me) — no API keys needed, free.
# ADMIN_PHONE is optional, for admin alerts.
ADMIN_PHONE=
PUBLIC_BACKEND_URL=
PUBLIC_FRONTEND_URL=

# Public admin/review media and AI article drafts (both optional)
BLOB_READ_WRITE_TOKEN=
ANTHROPIC_API_KEY=
# Private rider uploads. This token must belong to a separate private Vercel Blob store.
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Customer sign-in on the website (all optional; each method only appears when configured)
# Social: GOOGLE_*, FACEBOOK_CLIENT_ID/SECRET and APPLE_* above. Add this redirect URI in each provider's console:
#   <backend origin>/api/auth/callback/google  (or /facebook, /apple)
# Phone (SMS) and WhatsApp one-time codes use Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
# Optional approved WhatsApp booking confirmation templates; each template expects name, date, time, guests, and pass URL.
TWILIO_WHATSAPP_CONTENT_SID_A=
TWILIO_WHATSAPP_CONTENT_SID_B=
TWILIO_WHATSAPP_CONTENT_SID_C=

# SMS codes can also be sent through Infobip. SMS_PROVIDER_ORDER decides which is tried first (default "twilio,infobip");
# if a send fails the next configured provider is tried. INFOBIP_BASE_URL is the host shown in the Infobip portal.
INFOBIP_API_KEY=
INFOBIP_BASE_URL=
INFOBIP_SENDER=
SMS_PROVIDER_ORDER=
# Optional approved WhatsApp template with one variable {{1}} = the code (needed outside the 24-hour window)
TWILIO_WHATSAPP_OTP_CONTENT_SID=
# Optional: signs customer tokens. Defaults to NEXTAUTH_SECRET.
CUSTOMER_TOKEN_SECRET=
