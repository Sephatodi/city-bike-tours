
# The deployed Vite frontend origin. Local development may use http://localhost:5173.
# Production example: https://city-bike-tours.vercel.app
FRONTEND_ORIGIN=http://localhost:5173
# Optional; use only for trusted preview hostnames and do not add a trailing slash.
# CORS_ORIGIN_PATTERNS=https://city-bike-tours-*-your-team.vercel.app
# Neon connection string (recommended for production)
NEON_DATABASE_URL=
# Optional local database connection string; used when NEON_DATABASE_URL is not set
DATABASE_URL=

# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# In Render, set NEXTAUTH_URL to the public backend URL (e.g. https://city-bike-tours.onrender.com).

# Neon Auth is separate from NextAuth; configure its Auth URL and provider callbacks if using it.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Optional — OAuth providers only register if their vars are present.
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET=""

# Admin account created by `npm run admin:provision`
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Tour Administrator
ADMIN_PASSWORD=replace-before-use

# WhatsApp click-to-chat (wa.me) — no API keys needed, free.
# ADMIN_PHONE is optional, for admin alerts.
ADMIN_PHONE=
PUBLIC_BACKEND_URL=http://localhost:3000
PUBLIC_FRONTEND_URL=http://localhost:5173

# Admin uploads (Vercel Blob) and AI article drafts (both optional)
BLOB_READ_WRITE_TOKEN=
ANTHROPIC_API_KEY=

# Customer sign-in on the website (all optional; each method only appears when configured)
# Social: GOOGLE_*, FACEBOOK_CLIENT_ID/SECRET and APPLE_* above. Add this redirect URI in each provider's console:
#   <backend origin>/api/auth/callback/google  (or /facebook, /apple)
# Phone (SMS) and WhatsApp one-time codes use Twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
# Optional approved WhatsApp template with one variable {{1}} = the code (needed outside the 24-hour window)
TWILIO_WHATSAPP_OTP_CONTENT_SID=
# Optional: signs customer tokens. Defaults to NEXTAUTH_SECRET.
CUSTOMER_TOKEN_SECRET=
