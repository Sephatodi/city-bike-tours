# Local development: leave VITE_API_BASE_URL empty and proxy to the backend below.
# Production: set VITE_API_BASE_URL to the public Next.js backend origin.
VITE_API_BASE_URL=
# Override this when Next.js is running on a port other than 3000 (for example, http://localhost:3001).
VITE_API_PROXY_TARGET=http://localhost:3000
# Frontend origin (for ride pass URLs in admin)
VITE_FRONTEND_ORIGIN=http://localhost:5173
# Neon example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Backend URL, not the frontend URL. Set the real value in Render, not Vercel.
NEXTAUTH_URL="http://localhost:3000"
# Production example: https://city-bike-tours.onrender.com

# Optional — OAuth providers only register if their vars are present.
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET=""

# Production Vercel setting: VITE_API_BASE_URL=https://city-bike-tours.onrender.com
