# Local development: leave VITE_API_BASE_URL empty and proxy to the backend below.
# Production: set VITE_API_BASE_URL to the public Next.js backend origin.
VITE_API_BASE_URL=
# Override this when Next.js is running on a port other than 3000 (for example, http://localhost:3001).
VITE_API_PROXY_TARGET=http://localhost:3000
# Frontend origin (for ride pass URLs in admin)
VITE_FRONTEND_ORIGIN=http://localhost:5173
# Neon example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Required in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://city-bike-tours.vercel.app"

# Neon Auth (Google sign-in). Neon Console > your project > branch > Auth > Enable Auth, then copy the Auth URL.
# NEON_AUTH_COOKIE_SECRET: generate with  openssl rand -base64 32  (32+ characters).
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""

# Optional — OAuth providers only register if their vars are present.
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET=""

# Facebook: https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Apple (optional): APPLE_CLIENT_SECRET is the signed JWT described in lib/auth.js
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Shown on the privacy, terms and data-deletion pages (optional)
VITE_CONTACT_EMAIL=

# Optional street-route generation for /heritage-trail only
MAPBOX_TOKEN=
VITE_MAPBOX_TOKEN=
ORS_API_KEY=
TRAIL_PROVIDER=
